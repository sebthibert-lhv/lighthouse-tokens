{
  "source": ["tokens/**/*.json"],
  "platforms": {
    "ios-swift": {
      "transforms": [
        "name/camel",
        "color/ColorSwiftUI"
      ],
      "buildPath": "build/ios-swift/",
      "files": [
        {
          "destination": "LighthouseColor.swift",
          "format": "ios-swift/enum.swift",
          "options": {
            "className": "LighthouseColor",
            "import": ["SwiftUI"]
          }
        }
      ]
    },
    "compose": {
      "transforms": [
        "name/camel",
        "color/composeColor"
      ],
      "buildPath": "build/compose/",
      "files": [
        {
          "destination": "LighthouseColor.kt",
          "format": "compose/object",
          "options": {
            "className": "LighthouseColor",
            "packageName": "com.lhv.lighthouse"
          }
        }
      ]
    }
  }
}
